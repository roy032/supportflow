# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev; a Postgres URL works too)
# Postgres: postgresql+psycopg://user:password@host:5432/supportflow (docker compose sets this)
DATABASE_URL=sqlite:///./supportflow.db

# Tally webhook signing secret (Tally form -> Integrations -> Webhooks -> Signing secret).
# The placeholder below counts as unset: every webhook is rejected until you change it.
TALLY_SIGNING_SECRET=change-me

# Bearer token for /events and /failures, which return customer names, emails and messages.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder counts as unset: those endpoints reject every request until you change it.
ADMIN_API_KEY=change-me

# Largest webhook body accepted, in bytes (larger requests get 413)
MAX_WEBHOOK_BODY_BYTES=262144

# LLM provider: "ollama" (local, free) or "anthropic" (Claude, paid per token)
LLM_PROVIDER=ollama
# Tried when LLM_PROVIDER can't answer (down, timed out, rate limited); empty for none
LLM_FALLBACK_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120

# Claude (https://console.anthropic.com). Measure models with scripts/run_eval.py
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low is plenty for classification; raise it only if the eval shows a gain
ANTHROPIC_EFFORT=low

# Slack incoming webhook URL (leave empty to skip Slack while testing)
SLACK_WEBHOOK_URL=
# Signing secret of your Slack app (Basic Information -> App Credentials). When set, Slack
# messages get "Send suggested reply" and "Resolve" buttons, handled at /slack/interactions.
SLACK_SIGNING_SECRET=

# --- Helpdesk ---
# Your shop's name, used in reply drafts, email subjects and the dashboard
SHOP_NAME=Our shop
# Where this server is reachable from the internet, e.g. https://support.example.com.
# Used for "Open ticket" links in Slack; https also turns on secure dashboard cookies.
PUBLIC_URL=
# Folder of Markdown policy files the AI uses to draft replies (see knowledge/README.md)
KNOWLEDGE_DIR=knowledge
# Write an AI reply draft for each new ticket (a person always sends it)
DRAFT_REPLIES=true
# Close tickets classified as spam straight away
AUTO_RESOLVE_SPAM=true
# Post a Slack reminder when a ticket of this urgency has had no reply for this many
# minutes. 0 turns the reminder off for that urgency.
SLA_HIGH_MINUTES=60
SLA_MEDIUM_MINUTES=240
SLA_LOW_MINUTES=0

# Email replies to customers (any SMTP provider: Gmail app password, Brevo, Mailgun, SES...).
# Replies can't be sent until SMTP_HOST and SMTP_FROM are set. Port 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Agent dashboard at /dashboard. Sign-in is off until DASHBOARD_PASSWORD (12+ characters) is set.
DASHBOARD_PASSWORD=
# Signs dashboard cookies; falls back to ADMIN_API_KEY. Changing it signs everyone out.
SESSION_SECRET=

# Job queue: failed events are retried with exponential backoff, then marked `dead`.
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
# How long a worker may hold an event; must be at least 2 x LLM_TIMEOUT_SECONDS + 120.
JOB_LEASE_SECONDS=600
WORKER_POLL_SECONDS=2
# true: a worker thread runs inside the web server. In production set false and run
# `python -m app.worker` as its own process.
RUN_WORKER_IN_PROCESS=true

# Logging: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# "text" for a terminal, "json" (one object per line, with request_id / event_id) for a log pipeline
LOG_FORMAT=text
