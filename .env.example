# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev; a Postgres URL works too)
# Postgres: postgresql+psycopg://user:password@host:5432/supportflow (docker compose sets this)
DATABASE_URL=sqlite:///./supportflow.db

# Tally webhook signing secret (Tally form -> Integrations -> Webhooks -> Signing secret).
# The placeholder below counts as unset: every webhook is rejected until you change it.
TALLY_SIGNING_SECRET=change-me

# Bearer token for /events and /failures, which return customer names, emails and messages.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder counts as unset: those endpoints reject every request until you change it.
ADMIN_API_KEY=change-me

# Largest webhook body accepted, in bytes (larger requests get 413)
MAX_WEBHOOK_BODY_BYTES=262144

# LLM provider: "ollama" (local, free)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120

# Slack incoming webhook URL (leave empty to skip Slack while testing)
SLACK_WEBHOOK_URL=

# Job queue: failed events are retried with exponential backoff, then marked `dead`.
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
# How long a worker may hold an event; must be at least 2 x LLM_TIMEOUT_SECONDS + 120.
JOB_LEASE_SECONDS=600
WORKER_POLL_SECONDS=2
# true: a worker thread runs inside the web server. In production set false and run
# `python -m app.worker` as its own process.
RUN_WORKER_IN_PROCESS=true

# Logging: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# "text" for a terminal, "json" (one object per line, with request_id / event_id) for a log pipeline
LOG_FORMAT=text
